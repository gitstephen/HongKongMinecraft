{
	"name": "HongKong 3D Map",
	"description": "A Minecraft style Hong Kong Map",
	"version": "0.24",
	"manifest_version": 3,
	"action": {
		"default_popup": "popup.html",
		"default_icon": "mountain.png"
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"icons": {
		"16": "images/icon-16.png",
		"32": "images/icon-32.png",
		"48": "images/icon-48.png",
		"128": "images/icon-128.png"
	},
	"permissions": ["storage"],
	"host_permissions": ["<all_urls>"]
}